# {{ ansible_managed }}
# Third compose file, used only when wazuh_mcp_enabled. Same project as the Wazuh stack, so
# wazuh-mcp joins the default network and reaches wazuh.manager:55000 / wazuh.indexer:9200
# without either port being published.
services:
  wazuh-mcp:
    image: {{ wazuh_mcp_image }}
    hostname: wazuh-mcp
    restart: unless-stopped
    stop_grace_period: 30s
    depends_on:
      - wazuh.manager
      - wazuh.indexer
    env_file:
      - {{ wazuh_deploy_dir }}/mcp.env
    environment:
      MCP_HOST: 0.0.0.0
      MCP_PORT: "3000"
      ENVIRONMENT: production
{% if wazuh_mcp_forwarded_allow_ips | length > 0 %}
      # uvicorn: log the tailnet client from X-Forwarded-For instead of the bridge gateway
      FORWARDED_ALLOW_IPS: {{ wazuh_mcp_forwarded_allow_ips | to_json }}
{% endif %}
    ports:
      # Plain HTTP on loopback only; `tailscale serve` terminates TLS on {{ wazuh_mcp_https_port }}.
      - "127.0.0.1:3000:3000"
    volumes:
      - {{ wazuh_certs_dir }}/root-ca.pem:/app/certs/ca.pem:ro
    healthcheck:
      test: ["CMD-SHELL", "curl -sf --max-time 5 http://localhost:3000/health | jq -e '.status == \"healthy\"' > /dev/null"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 45s
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: {{ wazuh_mcp_memory_limit }}
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp:noexec,nosuid,size=64m
      - /app/logs:noexec,nosuid,size=128m,uid=1000,gid=1000
    # journald only for this container; the Wazuh containers keep Docker's default driver.
    logging:
      driver: journald
      options:
        tag: wazuh-mcp
