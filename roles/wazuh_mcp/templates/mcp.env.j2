# {{ ansible_managed }}
# Environment for the wazuh-mcp container. Secrets are single-quoted so Compose takes them literally.

# Manager API: internal Docker network only (55000 is never published).
WAZUH_HOST=wazuh.manager
WAZUH_PORT=55000
WAZUH_USER={{ wazuh_mcp_api_user }}
WAZUH_PASS='{{ vault_mcp_api_password }}'

# Indexer: internal Docker network only (9200 is never published).
WAZUH_INDEXER_HOST=wazuh.indexer
WAZUH_INDEXER_PORT=9200
WAZUH_INDEXER_USER={{ wazuh_mcp_indexer_user }}
WAZUH_INDEXER_PASS='{{ vault_mcp_indexer_password }}'

# TLS: the stack's root CA verifies the indexer. The stock manager API certificate
# (CN=wazuh.com, no SAN) cannot be verified, so it is accepted unverified; acceptable only
# because that hop never leaves the Docker network.
WAZUH_CA_BUNDLE=/app/certs/ca.pem
WAZUH_ALLOW_SELF_SIGNED=true

# Authentication: bearer JWTs minted from a single read-only API key.
AUTH_MODE=bearer
AUTH_SECRET_KEY='{{ vault_mcp_auth_secret }}'
MCP_API_KEY='{{ vault_mcp_api_key }}'
MCP_API_KEY_SCOPES=wazuh:read
TOKEN_LIFETIME_HOURS={{ wazuh_mcp_token_lifetime_hours }}

ALLOWED_ORIGINS={{ wazuh_mcp_allowed_origins | join(',') }}
{% if wazuh_mcp_tools_allowlist | length > 0 %}
WAZUH_TOOLSETS={{ wazuh_mcp_tools_allowlist | join(',') }}
{% endif %}
{% if wazuh_mcp_disabled_tools | length > 0 %}
WAZUH_DISABLED_TOOLS={{ wazuh_mcp_disabled_tools | join(',') }}
{% endif %}

# JSON logs go to journald (see docker-compose.mcp.yml) and from there into Wazuh.
LOG_LEVEL={{ wazuh_mcp_log_level }}
LOG_FORMAT=json
