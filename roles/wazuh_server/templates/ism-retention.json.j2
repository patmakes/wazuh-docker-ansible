{
  "policy": {
    "description": "Delete {{ wazuh_ism.pattern }} indices older than {{ wazuh_ism.days }} days (managed by Ansible)",
    "default_state": "hot",
    "states": [
      {
        "name": "hot",
        "actions": [],
        "transitions": [
          {
            "state_name": "delete",
            "conditions": {
              "min_index_age": "{{ wazuh_ism.days }}d"
            }
          }
        ]
      },
      {
        "name": "delete",
        "actions": [
          {
            "delete": {}
          }
        ],
        "transitions": []
      }
    ],
    "ism_template": [
      {
        "index_patterns": ["{{ wazuh_ism.pattern }}"],
        "priority": 100
      }
    ]
  }
}
