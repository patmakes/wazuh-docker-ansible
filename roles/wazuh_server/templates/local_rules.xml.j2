<!-- {{ ansible_managed }} -->
<!-- Local rules. Deployed to /var/ossec/etc/rules/local_rules.xml by roles/wazuh_server. -->

<group name="windows,windows_security,">
  <!--
    Quietens event 60107 (Windows audit failure) for processes that are known to be noisy
    when success/failure auditing is on. The process list is the role variable
    wazuh_60107_noisy_processes. Never add credential-handling or core OS processes
    (lsass.exe, svchost.exe, explorer.exe): excluding them hides credential-theft signals.
  -->
  <rule id="100008" level="4" frequency="{{ wazuh_60107_frequency }}" timeframe="{{ wazuh_60107_timeframe }}">
    <if_matched_sid>60107</if_matched_sid>
    <field name="win.eventdata.processName" type="pcre2">(?:{{ wazuh_60107_noisy_processes | map('regex_escape') | join('|') }})</field>
    <options>no_log</options>
    <description>Exclusion for rule 60107 when triggered repeatedly by a known noisy process (frequency {{ wazuh_60107_frequency }} within {{ wazuh_60107_timeframe }} seconds): {{ wazuh_60107_noisy_processes | join(', ') }}.</description>
    <mitre>
      <id>T1078</id>
    </mitre>
    <group>gdpr_IV_32.2,hipaa_164.312.b,nist_800_53_AC.6,nist_800_53_AU.14,pci_dss_10.2.2,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

</group>
